rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function serviceActive() {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let owner = user.role == 'landlord' ? request.auth.uid : user.get('landlordId', '');
      let lid = owner is string && owner != '' ? owner : '_unbound';
      return user.role == 'admin'
        || !firestore.exists(/databases/(default)/documents/platform_accounts/$(lid))
        || (!firestore.get(/databases/(default)/documents/platform_accounts/$(lid)).data.get('archived', false)
          && !(firestore.get(/databases/(default)/documents/platform_accounts/$(lid)).data.get('mode', 'active') in ['all', 'deleting', 'deleted'])
          && !(user.role == 'landlord' && firestore.get(/databases/(default)/documents/platform_accounts/$(lid)).data.get('mode', 'active') == 'landlord'));
    }
    // 合約、收據、報修圖片等原有路徑
    match /{root}/{allPaths=**} {
      allow read, write: if request.auth != null && root != 'platform_support' && serviceActive();
    }

    match /platform_support/{uid}/{operationId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || firestore.get(/databases/(default)/documents/platform_attachment_access/$(operationId)).data.landlordId == request.auth.uid);
      allow write: if request.auth != null && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.role in ['admin', 'landlord']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // 點交照片：thumb 給畫面與 PDF，orig 備查（退租結清滿 2 年由排程刪除）
    // 上傳一律經過壓縮，超過上限代表不是走正常流程
    match /inspections/{inspectionId}/{kind}/{fileName} {
      allow read: if request.auth != null && serviceActive();
      allow write: if request.auth != null && serviceActive()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 繳費截圖：只能寫入自己 uid 子目錄
    match /payment_proofs/{uid}/{fileName} {
      allow read: if request.auth != null && serviceActive();
      allow write: if request.auth != null && serviceActive() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
